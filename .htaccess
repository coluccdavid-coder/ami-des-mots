# Ami des mots — réglages pour un hébergement Apache (OVH).
# Compression : les scripts passent d'environ 1,5 Mo à 500 Ko.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/manifest+json
</IfModule>
AddType image/webp .webp
AddType application/manifest+json .webmanifest
AddType model/gltf-binary .glb
# Cache : images, polices et modèles 3D gardés 30 jours ; le code est revalidé à chaque visite
# (le service worker garde de toute façon tout le jeu pour le hors-ligne).
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|svg|woff2|glb|mp3|ogg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # v10.7 : le site ne s'affiche pas dans le cadre d'un autre site (vol de clic), HTTPS retenu un an par le navigateur,
  # et les capteurs inutiles au jeu (caméra, position, paiement par le navigateur, USB) sont coupés. Le micro reste au site lui-même.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'"
  Header always set Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
# v10.7 : les dossiers de travail ne sont jamais servis, même s'ils étaient envoyés par erreur.
<IfModule mod_alias.c>
  RedirectMatch 404 /(\.git|\.github|node_modules|tests|outils|docs)(/|$)
</IfModule>
# v5.97 : HTTPS obligatoire, et jamais de fichier de réglages ou de clé lisible depuis le web (même déposé par erreur dans www/).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
<FilesMatch "^(config.*\.php|.*\.(pem|p8|key|sqlite|sql|log|bak))$">
  Require all denied
</FilesMatch>
