# Seuls les points d'entrée publics sont accessibles.
Options -Indexes
<FilesMatch "^(lib\.php|config.*\.php|schema\.sql|.*\.pem|.*\.md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
</IfModule>
